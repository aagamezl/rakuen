#!/usr/bin/env bash
# Log the focused accessibility element (and its parents) for every key you press,
# so you can see what an app exposes. Run again to stop.
#
#   bin/ax-watch                  log every key for 120 seconds
#   bin/ax-watch 300              log for 300 seconds
#   bin/ax-watch 300 f2,return    log only those keys
#
# Output: /tmp/rakuen_ax_watch.log (this script follows it; Ctrl+C stops following,
# not the logging). Needs Hammerspoon running with the hs command line tool.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly LUA_SCRIPT="${SCRIPT_DIR}/../scripts/spikes/ax_watch.lua"
readonly LOG_FILE="/tmp/rakuen_ax_watch.log"
readonly SECONDS_DEFAULT=120

seconds="${1:-$SECONDS_DEFAULT}"
keys="${2:-}"

if ! command -v hs > /dev/null 2>&1; then
  printf 'ax-watch: the hs command line tool is not installed.\n' >&2

  exit 1
fi

result="$(hs -c "RAKUEN_AX_SECONDS=${seconds}; RAKUEN_AX_KEYS='${keys}'; return dofile('${LUA_SCRIPT}')" 2>&1 | tail -n 1)"
printf 'ax-watch: %s\n' "$result"

if [[ "$result" == "stopped" ]]; then
  exit 0
fi

printf 'Press keys in the app now. Following %s (Ctrl+C here stops following only).\n' "$LOG_FILE"
tail -f "$LOG_FILE"
